{
  "name": "jump2file",
  "displayName": "Jump2File",
  "description": "Jump to a related file using configurable regular expressions.",
  "version": "2026.9.4",
  "publisher": "SamuelMH",
  "repository": "https://github.com/samuelmh/vscode-jump2file",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jump2file.jump",
        "title": "Jump2File: Jump"
      }
    ],
    "configuration": {
      "title": "Jump2File",
      "properties": {
        "jump2file.rules": {
          "type": "array",
          "default": [],
          "description": "Ordered rules used to find related files.",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "description": "Regular expression matched against the absolute current file path (using / as separator)."
              },
              "to": {
                "type": "string",
                "description": "Destination template. Named captures use {$name}."
              },
              "create": {
                "type": "string",
                "description": "(OPTIONAL) If the file to jump does not exist, create? [yes, no, always]."
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "package": "npm run check-types && node esbuild.js --production && vsce package",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
